      "text": "ip link add vh{id} type veth peer name vc{id}\nip link set vh{id} up\nip link set vc{id} up\n\n// Veth host\nip link set vh{id} master br0\nbridge vlan add dev vh{id} vid {vlan} pvid untagged\n\n// Veth container\nPID=$(docker inspect -f '{{.State.Pid}}' {container})\nip link set vc{id} netns \"$PID\"\nnsenter -t \"$PID\" -n ip link set vc{id} up\nnsenter -t \"$PID\" -n ip addr add {ip} dev vc{id}\nnsenter -t \"$PID\" -n ip route replace default via {vlan_gateway}",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "Wbj3d0_0tHvVG3FmtzgfS",
      "originalText": "ip link add vh{id} type veth peer name vc{id}\nip link set vh{id} up\nip link set vc{id} up\n\n// Veth host\nip link set vh{id} master br0\nbridge vlan add dev vh{id} vid {vlan} pvid untagged\n\n// Veth container\nPID=$(docker inspect -f '{{.State.Pid}}' {container})\nip link set vc{id} netns \"$PID\"\nnsenter -t \"$PID\" -n ip link set vc{id} up\nnsenter -t \"$PID\" -n ip addr add {ip} dev vc{id}\nnsenter -t \"$PID\" -n ip route replace default via {vlan_gateway}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
